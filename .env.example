# ==============================================================================
# ECHO BRIDGE — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# ==============================================================================

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echobridge?schema=public"

# Auth.js / NextAuth (Admin CMS)
# Generate a secret in bash/terminal: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-char-random-secret-key-goes-here"

# Email Notifications (Resend)
RESEND_API_KEY="re_123456789"
NOTIFY_EMAIL="naren@echobridge.studio"

# Media Storage (Vercel Blob / Cloudflare R2 / S3)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# Bot Protection (Cloudflare Turnstile)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."

# Anti-Spam Rate Limiting (Upstash Redis)
# Get credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Error Monitoring (Sentry)
SENTRY_DSN=""

# Web Analytics (Google Analytics 4 / Plausible)
NEXT_PUBLIC_GA_ID=""

# On-Demand ISR Cache Revalidation Secret
REVALIDATE_SECRET="generate-a-secure-random-revalidation-token"
